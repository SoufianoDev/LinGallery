# Allow the current user (plugdev group) to access MTP USB devices.
# Place this file in /etc/udev/rules.d/ and run:
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# Then add your user to the plugdev group:
#   sudo usermod -aG plugdev $USER
# Log out and back in.

# Android / MTP devices (common VID/PID ranges)
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", ATTR{idProduct}=="6860", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", ATTR{idProduct}=="685c", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ee1", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ee2", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="4ee7", GROUP="plugdev", MODE="0660"

# Fallback: all MTP devices matching known class/subclass/protocol
SUBSYSTEM=="usb", ENV{ID_MTP_DEVICE}=="1", GROUP="plugdev", MODE="0660"
